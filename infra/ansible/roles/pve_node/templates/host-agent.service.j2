[Unit]
Description=pgcloud host agent (Proxmox node {{ pve_node_name }})
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/host-agent -config /etc/pgcloud/agent.yaml
EnvironmentFile=/etc/pgcloud/agent.env
Restart=always
RestartSec=5
User=root
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
