# /etc/pgcloud/pgcloud.env — rendered by Ansible from the vault; this file shows the shape.
# Everything the API reads (see .env.example at the repo root) plus what compose itself needs.

# compose
DOMAIN=pgcloud.example
ACME_EMAIL=ops@pgcloud.example
REGISTRY=ghcr.io/sharpyassir
IMAGE_TAG=latest
MGMT_IP=10.0.0.10                # management network address host agents reach NATS on
POSTGRES_PASSWORD=change-me
NATS_TOKEN=change-me
BACKUP_KEEP_DAYS=14
BACKUP_S3_URL=                   # s3://bucket/pgcloud (optional)
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# api and worker
PORT=4000
TEMPORAL_NAMESPACE=default
HYPERVISOR_DRIVER=proxmox        # fake on a demo box with no Proxmox
PROXMOX_URL=https://pve1.mgmt.internal:8006
PROXMOX_TOKEN_ID=pgcloud@pve!control-plane
PROXMOX_TOKEN_SECRET=change-me
PROXMOX_CEPH_POOL=vm-disks
PROXMOX_VXLAN_ZONE=customers
JWT_SECRET=change-me-64-random-bytes
SESSION_TTL_SECONDS=86400
REQUIRE_TOTP_FOR_OWNERS=true
CONSOLE_URL=https://console.pgcloud.example
MAIL_PROVIDER=postmark
MAIL_FROM="pgcloud <no-reply@pgcloud.example>"
MAIL_API_KEY=change-me
BILLING_HOURS_PER_MONTH=672
DEFAULT_CURRENCY=USD
FX_USD_TRY=41
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
