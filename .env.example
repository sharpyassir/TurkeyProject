# --- control plane (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://pgcloud:pgcloud@localhost:5432/pgcloud
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# fake | proxmox   (fake = provision in-memory VMs, no data plane needed)
HYPERVISOR_DRIVER=fake

# Proxmox (only when HYPERVISOR_DRIVER=proxmox)
PROXMOX_URL=https://pve1.ist1.internal:8006
PROXMOX_TOKEN_ID=pgcloud@pve!control-plane
PROXMOX_TOKEN_SECRET=
PROXMOX_CEPH_POOL=vm-disks
PROXMOX_VXLAN_ZONE=customers

# Auth
JWT_SECRET=change-me-in-production
SESSION_TTL_SECONDS=86400
REQUIRE_TOTP_FOR_OWNERS=false        # true in production: owners must enable two factor sign in
CONSOLE_URL=http://localhost:3000    # used in verification and reset links
PUBLIC_API_URL=http://localhost:4000 # what GitHub and customers reach; used in webhook URLs

# GitHub App for Git Deploy (optional). Create it at github.com/settings/apps with
# permissions Contents: read, Metadata: read; events: push, installation; webhook URL
# $PUBLIC_API_URL/v1/github/webhook; setup URL $CONSOLE_URL/github/callback (redirect on update: on).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=              # PEM contents, newlines as \n
GITHUB_APP_WEBHOOK_SECRET=

# Mail: log | postmark | resend
MAIL_PROVIDER=log
MAIL_FROM="pgcloud <no-reply@pgcloud.example>"
MAIL_API_KEY=

# Card payments: fake (built in test page) | stripe for USD | iyzico for TRY
PAYMENT_PROVIDER_USD=fake
PAYMENT_PROVIDER_TRY=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com   # https://api.iyzipay.com in production
# Seller details on invoice PDFs
COMPANY_NAME=pgcloud
COMPANY_ADDRESS=Türkiye
COMPANY_TAX_ID=

# Billing: every price is in USD; lira is converted at the stored USD→TRY rate
BILLING_HOURS_PER_MONTH=672
DEFAULT_CURRENCY=USD
FX_USD_TRY=41                       # fallback until the first rate is fetched or set
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD

# --- console (apps/console) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
