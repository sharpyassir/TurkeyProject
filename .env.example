# --- control plane (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://pgcloud:pgcloud@localhost:5432/pgcloud
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# fake | proxmox   (fake = provision in-memory VMs, no data plane needed)
HYPERVISOR_DRIVER=fake

# Proxmox (only when HYPERVISOR_DRIVER=proxmox)
PROXMOX_URL=https://pve1.ist1.internal:8006
PROXMOX_TOKEN_ID=pgcloud@pve!control-plane
PROXMOX_TOKEN_SECRET=
PROXMOX_CEPH_POOL=vm-disks
PROXMOX_VXLAN_ZONE=customers

# Auth
JWT_SECRET=change-me-in-production
SESSION_TTL_SECONDS=86400

# Billing: every price is in USD; lira is converted at the stored USD→TRY rate
BILLING_HOURS_PER_MONTH=672
DEFAULT_CURRENCY=USD
FX_USD_TRY=41                       # fallback until the first rate is fetched or set
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD

# --- console (apps/console) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
